{
  "name": "super-utils-plus",
  "version": "2.0.0",
  "description": "A superior alternative to Lodash with improved performance, TypeScript support, and developer experience",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./array": {
      "import": {
        "types": "./dist/esm/array/index.d.ts",
        "default": "./dist/esm/array/index.js"
      },
      "require": {
        "types": "./dist/cjs/array/index.d.ts",
        "default": "./dist/cjs/array/index.js"
      }
    },
    "./object": {
      "import": {
        "types": "./dist/esm/object/index.d.ts",
        "default": "./dist/esm/object/index.js"
      },
      "require": {
        "types": "./dist/cjs/object/index.d.ts",
        "default": "./dist/cjs/object/index.js"
      }
    },
    "./string": {
      "import": {
        "types": "./dist/esm/string/index.d.ts",
        "default": "./dist/esm/string/index.js"
      },
      "require": {
        "types": "./dist/cjs/string/index.d.ts",
        "default": "./dist/cjs/string/index.js"
      }
    },
    "./function": {
      "import": {
        "types": "./dist/esm/function/index.d.ts",
        "default": "./dist/esm/function/index.js"
      },
      "require": {
        "types": "./dist/cjs/function/index.d.ts",
        "default": "./dist/cjs/function/index.js"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/esm/utils/index.d.ts",
        "default": "./dist/esm/utils/index.js"
      },
      "require": {
        "types": "./dist/cjs/utils/index.d.ts",
        "default": "./dist/cjs/utils/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check",
    "demo": "node demo.js"
  },
  "keywords": [
    "utility",
    "utilities",
    "functional",
    "lodash",
    "lodash-alternative",
    "typescript",
    "javascript",
    "node",
    "array",
    "object",
    "string",
    "function",
    "debounce",
    "throttle",
    "range",
    "clamp",
    "performance"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhaxor/super-utils-plus.git"
  },
  "bugs": {
    "url": "https://github.com/dhaxor/super-utils-plus/issues"
  },
  "homepage": "https://github.com/dhaxor/super-utils-plus#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "jest": "^29.6.1",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.1.6"
  }
}
